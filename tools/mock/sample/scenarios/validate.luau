-- 자체 시험 1: 오타 · 틀린 형을 잡는가, 자료형이 Roblox처럼 도는가.
--  node tools/mock/run.mjs --project tools/mock/sample/default.project.json --script tools/mock/sample/scenarios/validate.luau
local h = harness
local shown = 0
local function mustFail(what: string, fn: () -> (), pattern: string)
	local msg = h.expectError(fn, pattern, what)
	if msg and shown < 12 then
		shown += 1
		print(string.format("  [잡음] %-28s → %s", what, msg))
	end
end

print("== 인스턴스 · 속성 검사 ==")
local f = Instance.new("Frame")
local t = Instance.new("TextLabel")
local img = Instance.new("ImageLabel")

mustFail("없는 클래스", function()
	Instance.new("Fraem")
end, 'Unable to create an Instance of type "Fraem"')
mustFail("만들 수 없는 클래스", function()
	Instance.new("GuiObject")
end, "Unable to create an Instance")
mustFail("속성 오타(쓰기)", function()
	(f :: any).BackgroundColour3 = Color3.new(1, 0, 0)
end, "BackgroundColour3 is not a valid member of Frame")
mustFail("속성 오타(읽기)", function()
	local _ = (f :: any).Sizee
end, "Sizee is not a valid member of Frame")
mustFail("수를 UDim2 속성에", function()
	(f :: any).Size = 5
end, "Unable to assign property Size. UDim2 expected, got number 5")
mustFail("Vector2를 UDim2 속성에", function()
	(f :: any).Position = Vector2.new(1, 2)
end, "UDim2 expected, got Vector2")
mustFail("문자열을 수 속성에", function()
	(f :: any).BackgroundTransparency = "half"
end, "number expected, got string")
mustFail("수를 불 속성에", function()
	(f :: any).Visible = 1
end, "boolean expected, got number")
mustFail("Vector3를 Color3 속성에", function()
	(f :: any).BackgroundColor3 = Vector3.new(1, 1, 1)
end, "Color3 expected, got Vector3")
mustFail("문자열을 열거형 속성에", function()
	(t :: any).TextXAlignment = "Left"
end, "Enum.TextXAlignment expected, got string")
mustFail("다른 열거형을 열거형 속성에", function()
	(t :: any).TextXAlignment = Enum.TextYAlignment.Top
end, "다른 열거형")
mustFail("없는 열거형 값", function()
	t.Font = (Enum.Font :: any).SourceSansBolt
end, 'SourceSansBolt is not a valid member of "Enum.Font"')
mustFail("없는 열거형", function()
	local _ = (Enum :: any).KeyCod.W
end, 'KeyCod is not a valid member of "Enum"')
mustFail("읽기 전용 속성", function()
	(f :: any).AbsoluteSize = Vector2.new(1, 1)
end, "Unable to assign property AbsoluteSize. Property is read only")
mustFail("메서드 오타", function()
	(f :: any):Destory()
end, "Destory is not a valid member of Frame")
mustFail("점으로 부른 메서드", function()
	(f :: any).Destroy()
end, "Expected ':' not '.' calling member function Destroy")
mustFail("빠진 인자", function()
	(f :: any):FindFirstChild()
end, "Argument 1 missing or nil")
mustFail("틀린 형의 인자", function()
	(f :: any):TweenPosition(5)
end, "UDim2")
mustFail("없는 서비스", function()
	game:GetService("Playerz")
end, "'Playerz' is not a valid Service name")
mustFail("Parent에 문자열", function()
	(f :: any).Parent = "PlayerGui"
end, "Instance expected, got string")
mustFail("nil을 UDim2 속성에", function()
	(f :: any).Size = nil
end, "UDim2 expected, got nil")
mustFail("문자열을 Content 속성에", function()
	(img :: any).ImageContent = "rbxassetid://1"
end, "Content expected, got string")
mustFail("이벤트에 값 넣기", function()
	(f :: any).MouseEnter = function() end
end, "MouseEnter is not a valid member")
mustFail("신호의 메서드 오타", function()
	(f.MouseEnter :: any):Conect(function() end)
end, "Conect is not a valid member of RBXScriptSignal")
mustFail("Connect에 함수가 아닌 것", function()
	(f.MouseEnter :: any):Connect(5)
end, "Passed value is not a function")
mustFail("없는 속성의 바뀜 신호", function()
	f:GetPropertyChangedSignal("AbsoluteSiz")
end, "AbsoluteSiz is not a valid property name")
mustFail("TweenInfo에 문자열", function()
	TweenInfo.new(1, "Quad" :: any)
end, "Enum.EasingStyle")
mustFail("트윈: 없는 속성", function()
	game:GetService("TweenService"):Create(f, TweenInfo.new(1), { Pozition = UDim2.new() })
end, "no property named 'Pozition'")
mustFail("트윈: 틀린 형", function()
	game:GetService("TweenService"):Create(f, TweenInfo.new(1), { Position = 5 })
end, "cannot be tweened due to type mismatch")
mustFail("속성(Attribute)에 표", function()
	f:SetAttribute("Data", {} :: any)
end, "is not a supported attribute type")
mustFail("자료형의 없는 칸", function()
	local _ = (Vector2.new(1, 2) :: any).Z
end, "Z is not a valid member of Vector2")
mustFail("자료형 고치기", function()
	(Vector2.new(1, 2) :: any).X = 5
end, "readonly")
mustFail("Vector2 + 수", function()
	local _ = (Vector2.new(1, 2) :: any) + 1
end, "attempt to perform arithmetic (add) on Vector2 and number")
mustFail("Color3.fromHex 틀린 글", function()
	Color3.fromHex("#12")
end, "Color3.fromHex")
mustFail("UDim2.new에 문자열", function()
	UDim2.new("a" :: any, 0, 0, 0)
end, "UDim2.new")
mustFail("EditableImage: 버퍼 길이", function()
	local ei = game:GetService("AssetService"):CreateEditableImage({ Size = Vector2.new(4, 4) })
	ei:WritePixelsBuffer(Vector2.zero, Vector2.new(4, 4), buffer.create(60))
end, "64바이트")
mustFail("EditableImage: 그림판 밖", function()
	local ei = game:GetService("AssetService"):CreateEditableImage({ Size = Vector2.new(4, 4) })
	ei:WritePixelsBuffer(Vector2.new(2, 2), Vector2.new(4, 4), buffer.create(64))
end, "밖으로 나간다")
mustFail("EditableImage: 옵션 오타", function()
	game:GetService("AssetService"):CreateEditableImage({ size = Vector2.new(4, 4) } :: any)
end, "모르는 옵션 'size'")
mustFail("StarterGui:SetCore 이름 오타", function()
	game:GetService("StarterGui"):SetCore("ResetButtonCalback", false)
end, "has not been registered")
mustFail("SetCoreGuiEnabled에 문자열", function()
	game:GetService("StarterGui"):SetCoreGuiEnabled("PlayerList" :: any, false)
end, "Enum.CoreGuiType")

-- 귀띔(혹시 …?)이 붙는가
local msg = h.expectError(function()
	(t :: any).TextColour3 = Color3.new()
end, '혹시 "TextColor3"?')
print("  귀띔:", msg)

-- 받아 주는 것(Roblox가 받아 주는 변환)
t.Text = 5 :: any
h.eq(t.Text, "5", "수 → 문자열")
t.TextSize = "14" :: any
h.eq(t.TextSize, 14, "수로 읽히는 문자열 → 수")
f.ZIndex = 2.9 :: any
h.eq(f.ZIndex, 2, "정수 속성은 소수를 버린다")

print("== 나무 · 아이 ==")
local parent = Instance.new("Folder")
parent.Name = "Root"
local a = Instance.new("Frame", parent)
a.Name = "A"
local b = Instance.new("Frame")
b.Name = "B"
b.Parent = a
h.eq(parent.A.B, b, "이름으로 아이 찾기")
h.eq(parent:FindFirstChild("B", true), b, "FindFirstChild(recursive)")
h.eq(parent:FindFirstChild("B"), nil, "FindFirstChild(바로 아래만)")
h.eq(#parent:GetDescendants(), 2, "GetDescendants")
h.eq(b:IsDescendantOf(parent), true, "IsDescendantOf")
h.eq(b:FindFirstAncestor("Root"), parent, "FindFirstAncestor")
h.eq(b:FindFirstAncestorOfClass("Folder"), parent, "FindFirstAncestorOfClass")
h.eq(parent:FindFirstChildWhichIsA("GuiObject"), a, "FindFirstChildWhichIsA")
h.eq(a:IsA("GuiObject"), true, "IsA(윗 클래스)")
h.eq(a:IsA("TextLabel"), false, "IsA(다른 클래스)")
h.eq(b:GetFullName(), "Root.A.B", "GetFullName")
h.eq(typeof(a), "Instance", "typeof(인스턴스)")
h.eq(type(a), "userdata", "type(인스턴스)")
h.eq(tostring(a), "A", "tostring(인스턴스)")
mustFail("자기를 부모로", function()
	a.Parent = a
end, "as its own parent")
mustFail("돌고 도는 부모", function()
	a.Parent = b
end, "would result in circular reference")

local events = {}
parent.ChildAdded:Connect(function(c)
	table.insert(events, "added " .. c.Name)
end)
parent.ChildRemoved:Connect(function(c)
	table.insert(events, "removed " .. c.Name)
end)
parent.DescendantAdded:Connect(function(c)
	table.insert(events, "desc " .. c.Name)
end)
a.AncestryChanged:Connect(function(child, newParent)
	table.insert(events, "ancestry " .. child.Name .. " → " .. tostring(newParent))
end)
a:GetPropertyChangedSignal("Name"):Connect(function()
	table.insert(events, "name " .. a.Name)
end)
a.Changed:Connect(function(prop)
	table.insert(events, "changed " .. prop)
end)
b.Destroying:Connect(function()
	table.insert(events, "destroying B")
end)
local c = Instance.new("TextLabel")
c.Name = "C"
c.Parent = parent
a.Name = "A2"
a.Parent = nil
a.Parent = parent
h.eq(events, { "added C", "desc C", "name A2", "changed Name", "removed A2", "ancestry A2 → nil", "changed Parent", "added A2", "desc A2", "desc B", "ancestry A2 → Root", "changed Parent" }, "이벤트의 차례")

local copy = a:Clone()
h.eq(copy.Name, "A2", "Clone: 이름")
h.eq(copy.Parent, nil, "Clone: 부모 없음")
h.eq(copy.B ~= b and copy.B.ClassName == "Frame", true, "Clone: 아이도 베낀다")
a:SetAttribute("Hp", 10)
a:AddTag("Enemy")
local copy2 = a:Clone()
h.eq(copy2:GetAttribute("Hp"), 10, "Clone: 속성(Attribute)")
h.eq(copy2:HasTag("Enemy"), true, "Clone: 꼬리표")

a:Destroy()
h.eq(a.Parent, nil, "Destroy: 부모가 없다")
h.eq(b.Parent, nil, "Destroy: 아이도 떼어진다")
h.eq(events[#events], "destroying B", "Destroying 이벤트")
mustFail("Destroy 뒤 Parent 넣기", function()
	a.Parent = parent
end, "The Parent property of A2 is locked")
parent:ClearAllChildren()
h.eq(#parent:GetChildren(), 0, "ClearAllChildren")

print("== 자료형 ==")
local v = Vector2.new(3, 4)
h.eq(v.Magnitude, 5, "Vector2.Magnitude")
h.eq(v + Vector2.new(1, 1), Vector2.new(4, 5), "Vector2 +")
h.eq(v * 2, Vector2.new(6, 8), "Vector2 * 수")
h.eq(2 * v, Vector2.new(6, 8), "수 * Vector2")
h.eq(v / Vector2.new(3, 2), Vector2.new(1, 2), "Vector2 / Vector2")
h.eq(-v, Vector2.new(-3, -4), "-Vector2")
h.eq(v:Lerp(Vector2.zero, 0.5), Vector2.new(1.5, 2), "Vector2:Lerp")
h.eq(v:Dot(Vector2.new(1, 0)), 3, "Vector2:Dot")
h.eq(tostring(v), "3, 4", "tostring(Vector2)")
h.eq(typeof(v), "Vector2", "typeof(Vector2)")
h.eq(type(v), "userdata", "type(Vector2)")
h.eq(Vector2.one.X, 1, "Vector2.one")
local u = UDim2.new(0.5, 10, 1, -20)
h.eq(u.X.Scale, 0.5, "UDim2.X.Scale")
h.eq(u.Y.Offset, -20, "UDim2.Y.Offset")
h.eq(u + UDim2.fromOffset(5, 5), UDim2.new(0.5, 15, 1, -15), "UDim2 +")
h.eq(u - UDim2.fromScale(0.5, 0), UDim2.new(0, 10, 1, -20), "UDim2 -")
h.eq(UDim2.fromScale(0, 0):Lerp(UDim2.fromScale(1, 1), 0.25), UDim2.fromScale(0.25, 0.25), "UDim2:Lerp")
h.eq(UDim2.new(UDim.new(0.5, 1), UDim.new(0, 2)), UDim2.new(0.5, 1, 0, 2), "UDim2.new(UDim, UDim)")
h.eq(tostring(u), "{0.5, 10}, {1, -20}", "tostring(UDim2)")
h.eq(UDim.new(1, 2) + UDim.new(0, 3), UDim.new(1, 5), "UDim +")
local col = Color3.fromRGB(255, 128, 0)
h.near(col.G, 128 / 255, 1e-9, "Color3.fromRGB")
h.eq(col:ToHex(), "ff8000", "Color3:ToHex")
h.eq(Color3.fromHex("#FF8000"), col, "Color3.fromHex")
h.eq(Color3.fromHex("f80"), Color3.fromRGB(255, 136, 0), "Color3.fromHex(세 글자)")
local hh, ss, vv = Color3.fromRGB(255, 0, 0):ToHSV()
h.eq({ hh, ss, vv }, { 0, 1, 1 }, "Color3:ToHSV")
h.eq(Color3.fromHSV(1 / 3, 1, 1), Color3.new(0, 1, 0), "Color3.fromHSV")
h.eq(Color3.new(0, 0, 0):Lerp(Color3.new(1, 1, 1), 0.5), Color3.new(0.5, 0.5, 0.5), "Color3:Lerp")
h.eq(typeof(col), "Color3", "typeof(Color3)")
local r = Rect.new(1, 2, 11, 22)
h.eq({ r.Width, r.Height, r.Min.X, r.Max.Y }, { 10, 20, 1, 22 }, "Rect")
h.eq(NumberRange.new(1, 5).Max, 5, "NumberRange")
local ns = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 1), NumberSequenceKeypoint.new(1, 0) })
h.eq(#ns.Keypoints, 3, "NumberSequence.Keypoints")
local cs = ColorSequence.new(Color3.new(1, 0, 0), Color3.new(0, 0, 1))
h.eq(cs.Keypoints[2].Value, Color3.new(0, 0, 1), "ColorSequence.Keypoints")
mustFail("ColorSequence: Time이 0으로 시작하지 않음", function()
	ColorSequence.new({ ColorSequenceKeypoint.new(0.1, Color3.new()), ColorSequenceKeypoint.new(1, Color3.new()) })
end, "첫 점의 Time은 0")
local ti = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true, 0.5)
h.eq({ ti.Time, ti.EasingStyle, ti.EasingDirection, ti.RepeatCount, ti.Reverses, ti.DelayTime }, { 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true, 0.5 }, "TweenInfo")
local font = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)
h.eq({ font.Family, font.Weight, font.Style, font.Bold }, { "rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic, true }, "Font.new")
h.eq(Font.fromEnum(Enum.Font.GothamBold), Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold), "Font.fromEnum")
h.eq(Font.fromName("Roboto").Family, "rbxasset://fonts/families/Roboto.json", "Font.fromName")
h.eq(Font.fromId(123).Family, "rbxassetid://123", "Font.fromId")
t.Font = Enum.Font.GothamBold
h.eq(t.FontFace, Font.fromEnum(Enum.Font.GothamBold), "Font → FontFace")
t.FontFace = Font.fromEnum(Enum.Font.SourceSans)
h.eq(t.Font, Enum.Font.SourceSans, "FontFace → Font")
local content = Content.fromUri("rbxassetid://77")
h.eq({ content.SourceType, content.Uri, content.Object }, { Enum.ContentSourceType.Uri, "rbxassetid://77" }, "Content.fromUri")
h.eq(Content.none.SourceType, Enum.ContentSourceType.None, "Content.none")
img.Image = "rbxassetid://5"
h.eq(img.ImageContent, Content.fromUri("rbxassetid://5"), "Image → ImageContent")
local ei = game:GetService("AssetService"):CreateEditableImage({ Size = Vector2.new(8, 4) })
h.eq(ei.Size, Vector2.new(8, 4), "EditableImage.Size")
local px = buffer.create(8 * 4 * 4)
buffer.writeu32(px, 0, 0xFF0000FF)
ei:WritePixelsBuffer(Vector2.zero, Vector2.new(8, 4), px)
h.eq(buffer.readu32(ei:ReadPixelsBuffer(Vector2.zero, Vector2.new(1, 1)), 0), 0xFF0000FF, "EditableImage 쓰고 읽기")
img.ImageContent = Content.fromObject(ei)
h.eq({ img.Image, img.ImageContent.SourceType, img.ImageContent.Object }, { "", Enum.ContentSourceType.Object, ei }, "ImageContent(Object) → Image는 빈 글")
h.eq(typeof(ei), "Object", "typeof(EditableImage)")
h.eq(typeof(Enum.KeyCode.W), "EnumItem", "typeof(EnumItem)")
h.eq(typeof(Enum.KeyCode), "Enum", "typeof(Enum)")
h.eq({ Enum.KeyCode.W.Name, Enum.KeyCode.W.Value, Enum.KeyCode.W.EnumType }, { "W", 119, Enum.KeyCode }, "EnumItem의 칸")
h.eq(tostring(Enum.KeyCode.W), "Enum.KeyCode.W", "tostring(EnumItem)")
h.eq(Enum.KeyCode:FromName("Space"), Enum.KeyCode.Space, "Enum:FromName")
h.eq(Enum.KeyCode.W:IsA("KeyCode"), true, "EnumItem:IsA")
h.eq(typeof(f.MouseEnter), "RBXScriptSignal", "typeof(신호)")
h.eq(typeof(f.MouseEnter:Connect(function() end)), "RBXScriptConnection", "typeof(연결)")
h.eq(typeof({}), "table", "typeof(표)")
h.eq(type({}), "table", "type(표)")
h.eq(typeof(buffer.create(1)), "buffer", "typeof(buffer)")

print("== require ==")
local extraModule = h.get("game.Players.Player1.PlayerScripts.client.Extra")
h.eq(extraModule.ClassName, "ModuleScript", "init.luau가 있는 폴더는 ModuleScript")
local extra = h.require(extraModule, "client")
h.eq(extra.child, { who = "Players.Player1.PlayerScripts.client.Extra.Child", parentName = "Extra" }, 'require("@self/Child")')
h.eq({ extra.stageSame, extra.title ~= nil, extra.name, extra.className }, { true, true, "Extra", "ModuleScript" }, 'require("./Stage") · require("@game/…") · script')
h.eq(h.require(extraModule, "client") == extra, true, "두 번 불러도 같은 값(한 번만 돈다)")
h.eq(h.require(extraModule, "server") ~= extra, true, "서버 쪽은 따로 읽는다")
mustFail("require에 모듈이 아닌 것", function()
	require(h.game.ReplicatedStorage :: any)
end, "Attempted to call require with invalid argument")

print("== HttpService ==")
local Http = game:GetService("HttpService")
local json = Http:JSONEncode({ name = "가", list = { 1, 2, 3 }, on = true })
h.eq(Http:JSONDecode(json), { name = "가", list = { 1, 2, 3 }, on = true }, "JSON 왕복")
